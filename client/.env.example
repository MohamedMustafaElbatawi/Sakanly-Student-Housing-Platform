# ==========================================
# Sakanly Client Environment Variables
# ==========================================

# Google Identity Services Client ID
# احصل على هذا المعرف من Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs > Web application)
# Authorized JavaScript origins: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# Backend REST API Base URL
# Development: /api/v1 (routed via Vite proxy to localhost:5000) or http://localhost:5000/api/v1
# Production (Standalone Vercel Deployment): https://your-backend-api.vercel.app/api/v1
# Production (Single domain / Reverse proxy): /api/v1
VITE_API_BASE_URL=/api/v1
