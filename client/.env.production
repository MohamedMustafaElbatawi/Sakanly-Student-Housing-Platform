# ==========================================
# Sakanly Client Environment Variables (Production)
# ==========================================

VITE_GOOGLE_CLIENT_ID=768182677633-n195qbgt5al4jd8ji921p1k9nkkb2rg3.apps.googleusercontent.com

# When deploying Frontend to Vercel as a standalone project, set this to your hosted Backend API URL:
# (Set in Vercel Dashboard > Project Settings > Environment Variables)
# Example: https://sakanly-backend.vercel.app/api/v1
# If using a reverse-proxy (single domain for both frontend & backend), you can leave as /api/v1
VITE_API_BASE_URL=/api/v1
