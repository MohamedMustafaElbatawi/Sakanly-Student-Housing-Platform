# ==========================================
# Sakanly Server Environment Variables
# ==========================================

PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ==========================================
# Database Configuration (MongoDB Atlas)
# ==========================================
# Connect to your MongoDB Atlas cluster or local MongoDB instance:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sakanly?retryWrites=true&w=majority
# (If omitted, the server operates with resilient in-memory store fallback)

# Secret key for signing Sakanly JWT session tokens
JWT_SECRET=sakanly_jwt_secret_dev_key_2026

# Super Admin Credentials (used by seed script only)
SUPER_ADMIN_EMAIL=admin@sakanly.com
SUPER_ADMIN_PASSWORD=YourSecurePassword_MinLength12
SUPER_ADMIN_NAME=إدارة منصة سكنلي

# Allowed Origins for CORS (comma-separated for multiple production/staging domains)
# Example: https://sakanly.com,https://www.sakanly.com,https://sakanly.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google OAuth 2.0 Web Client ID (Must match the VITE_GOOGLE_CLIENT_ID used in client)
# Used by google-auth-library on the server to verify audience of ID tokens
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# Google Client Secret (Optional - server-side only, NEVER expose to React frontend)
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder

# Cloudinary Media Storage (Backend)
# Obtain from Cloudinary Dashboard > Dashboard > Product Environment Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==========================================
# Real SMS Gateway / Mobile OTP Configuration
# ==========================================
# Choose active SMS provider: twilio | infobip | generic | mock
SMS_PROVIDER=twilio

# Option 1: Twilio (Default International Gateway)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option 2: Infobip
# INFOBIP_API_KEY=your_infobip_api_key
# INFOBIP_BASE_URL=https://xxxxx.api.infobip.com
# INFOBIP_SENDER_ID=Sakanly

# Option 3: Generic Egyptian HTTP Gateway (VictoryLink, Vodafone SMS, Cequens)
# SMS_GATEWAY_URL=https://sms-provider.com/api/send
# SMS_API_KEY=your_sms_gateway_api_key
# SMS_SENDER_ID=Sakanly

# ==========================================
# Brevo Transactional Email API (Email OTP Verification)
# ==========================================
# Get your free API key from Brevo: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=no-reply@sakanly.com
BREVO_SENDER_NAME="سكنلي | Sakanly"

