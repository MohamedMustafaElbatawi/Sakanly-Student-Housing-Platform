# Sakanly Environment Configuration Example

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=your_jwt_secret_key_change_in_production_2026

# Google OAuth 2.0 Credentials (Backend)
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Cloudinary Media Storage (Backend)
# Obtain from Cloudinary Dashboard > Programmable Media > API Keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Client Configuration
VITE_API_BASE_URL=http://localhost:5000/api/v1
# Public Google Client ID for frontend Google Identity Services
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

